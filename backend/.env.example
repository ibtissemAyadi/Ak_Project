# Copier ce fichier en .env (local) et NE JAMAIS committer les valeurs réelles.
# Sur Render : configurer chacune de ces variables dans l'onglet Environment.

# Clé secrète Django. Générer une nouvelle valeur, ne jamais réutiliser
# celle qui a été présente en dur dans settings.py (considérée compromise).
# Génération : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False en production. True uniquement en développement local.
DEBUG=False

# Domaines autorisés à servir l'API, séparés par des virgules.
# Ex. production : gestion-ak-backend.onrender.com
# Ex. local       : 127.0.0.1,localhost
ALLOWED_HOSTS=

# Origines autorisées à appeler l'API en CORS, séparées par des virgules.
# Ex. production : https://gestion-ak.vercel.app
# Ex. local       : http://localhost:5173,http://localhost:5174
CORS_ALLOWED_ORIGINS=

# Origines de confiance pour le CSRF (utile pour /admin/ en production).
# Même valeurs que CORS_ALLOWED_ORIGINS, avec le schéma https:// inclus.
CSRF_TRUSTED_ORIGINS=

# Chaîne de connexion PostgreSQL complète.
# Fournie par Supabase : Project Settings > Database > Connection string (URI).
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
